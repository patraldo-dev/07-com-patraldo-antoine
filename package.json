		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"wrangler": "^4.28.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
